# ╔══════════════════════════════════════════════════════════════════╗
# ║  Factory Guardian — Environment Configuration                  ║
# ║  Copy this file to .env and fill in your values.               ║
# ╚══════════════════════════════════════════════════════════════════╝

# --- LLM (Groq / LiteLLM) ---
GROQ_API_KEY=GROQ_API_KEY_HERE
GROQ_MODEL=groq/llama3-groq-70b-8192-tool-use-preview

# --- Robot identity ---
ROBOT_NAME=factory_guardian

# --- Simulation mode ---
# Set to false when connected to real ESP32 hardware via MQTT.
MOCK_MODE=true

# --- MQTT (ESP32 communication) ---
MQTT_BROKER=localhost
MQTT_PORT=1883
MQTT_TOPIC_MOTOR=factory_guardian/motor
MQTT_TOPIC_STATUS=factory_guardian/status
MQTT_TOPIC_ACTION_DONE=factory_guardian/action_done

# --- Camera ---
# Use CAMERA_INDEX for local webcam (0 = default).
# Use CAMERA_URL for an RTSP/HTTP stream (overrides index).
CAMERA_INDEX=0
CAMERA_URL=
CAMERA_FRAME_WIDTH=640
CAMERA_FRAME_HEIGHT=480

# --- YOLO / Safety detection ---
# Model is auto-downloaded by ultralytics on first use.
YOLO_MODEL_PATH=yolov8n.pt
YOLO_CONFIDENCE=0.40
# Comma-separated COCO class IDs to monitor (0 = person)
YOLO_SAFETY_CLASSES=0

# --- Speed constraints ---
ROBOT_DEFAULT_SPEED=0.3
ROBOT_MAX_SPEED=1.0

# --- Legacy ROS 2 (for future hardware integration) ---
ROS_DOMAIN_ID=0
CMD_SET_POSITION=1.0
CMD_GO_TO=2.0
SERVICE_TIMEOUT_SEC=3.0

# --- Gradio UI ---
GRADIO_SERVER_NAME=0.0.0.0
GRADIO_SERVER_PORT=7860